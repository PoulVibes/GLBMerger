<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MeshoptNative passes raw pointers to meshoptimizer's C API. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);MSB3277;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meshoptimizer.NET" Version="1.0.7" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />
    <PackageReference Include="SharpAssimp" Version="6.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ball prop shown in BallAnchorForm's live preview instead of a placeholder sphere -->
    <None Include="Assets\Football1.glb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>